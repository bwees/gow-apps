{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>home-operations/renovate-presets"],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "matchUpdateTypes": ["major", "minor", "patch"],
      "semanticCommitType": "chore"
    },
    {
      "matchDepNames": ["Eglantine-Community/Eglantine"],
      "versioning": "semver",
      "allowedVersions": "/^v\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.]+)?$/",
      "ignoreUnstable": false,
      "groupName": "eglantine"
    },
    {
      "matchDepNames": ["projects/Ryubing"],
      "registryUrls": ["https://git.ryujinx.app"],
      "groupName": "ryujinx"
    },
    {
      "matchDepNames": ["Eglantine-Community/Eglantine", "projects/Ryubing"],
      "matchUpdateTypes": ["major", "minor", "patch"],
      "automerge": true
    }
  ],
  "ignoreTests": true
}
